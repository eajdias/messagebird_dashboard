# ============================================================
# MessageBird Dashboard — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://mbird:sua_senha_aqui@localhost:5432/mbird_reports

# --- Auth ---
JWT_SECRET=gere_um_secret_forte_aqui_minimo_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- MessageBird API ---
MESSAGEBIRD_API_KEY_LIVE=sua_api_key_aqui
MESSAGEBIRD_WORKSPACE_ID_LIVE=seu_workspace_id_aqui
MESSAGEBIRD_API_KEY_TEST=sua_test_key_aqui
MESSAGEBIRD_WORKSPACE_ID_TEST=seu_test_workspace_id_aqui
MESSAGEBIRD_BASE_URL_CONVERSATIONS=https://conversations.messagebird.com/v1
MESSAGEBIRD_BASE_URL_CONTACTS=https://contacts.messagebird.com/v2
MESSAGEBIRD_BASE_URL_BIRD=https://api.bird.com
MESSAGEBIRD_HTTP_TIMEOUT=60.0
MESSAGEBIRD_TIMEZONE_OFFSET=-3
MESSAGEBIRD_PHRASE_TICKET_HEADER="\"=== Informações Ticket ===\""
MESSAGEBIRD_SOFTWARE_NAMES="\"Zscan,Yoovet\""

# --- Sync ---
# Perfis: debug (15min), short (30min), hourly (1h), daily, weekly, monthly
SYNC_PROFILE=daily
SYNC_ENABLED=true

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
