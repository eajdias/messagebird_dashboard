curl http://localhost:8042/worklists/?format=Full
curl http://localhost:8042/system
curl http://localhost:8043/system
curl http://localhost:8043/studies | jq

docker logs -f orthanc-worklist
docker logs -f orthanc-pacs
docker logs orthanc-worklist | grep -i worklist

